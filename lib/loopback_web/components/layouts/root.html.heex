<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Loopback">
      <%= assigns[:page_title] || "Loopback" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href="/assets/app.css" />
    <script defer phx-track-static type="text/javascript" src="/assets/app.js">
    </script>
  </head>
  <body class="bg-white antialiased">
    <nav class="border-b border-zinc-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-12 justify-between">
          <div class="flex items-center gap-6">
            <a href="/" class="text-sm font-semibold text-zinc-900 hover:text-zinc-700 transition-colors">
              Loopback
            </a>
            <a
              href="/tunnels"
              class="text-sm text-zinc-600 hover:text-zinc-900 transition-colors"
            >
              Tunnels
            </a>
            <a
              href="/dev/dashboard"
              class="text-sm text-zinc-600 hover:text-zinc-900 transition-colors"
            >
              Dashboard
            </a>
          </div>
        </div>
      </div>
    </nav>
    <%= @inner_content %>
  </body>
</html>
